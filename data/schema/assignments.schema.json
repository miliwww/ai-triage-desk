    },
    "rule_version": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    }
  },
  "required": [
    "approved_by",
    "assigned_at",
    "assignee_id",
    "decision",
    "id",
    "is_synthetic",
    "rule_version",
    "team_id",
    "ticket_id"
