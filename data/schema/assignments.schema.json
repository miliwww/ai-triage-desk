        "null",
        "string"
      ]
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "assignee_id": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "is_synthetic": {
      "type": "boolean",
