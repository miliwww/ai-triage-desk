    },
    "current_open_ticket_count": {
      "type": "integer"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "is_synthetic": {
      "type": "boolean",
