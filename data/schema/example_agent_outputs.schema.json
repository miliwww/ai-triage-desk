{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evaluation/example_agent_outputs.jsonl单条记录契约",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "escalate_immediately": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "assigned": {
          "type": "boolean"
        },
        "device_command_sent": {
          "type": "boolean"
        },
        "warranty_approved": {
          "type": "boolean"
        }
      },
      "required": [
        "assigned",
        "device_command_sent",
        "warranty_approved"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string"
    },
    "is_synthetic": {
      "type": "boolean",
      "const": true
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "requires_human": {
      "type": "boolean",
      "const": true
    },
    "root_cause": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "user_reply_draft_zh": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "category_id",
    "confidence",
    "escalate_immediately",
    "evidence",
    "execution",
    "id",
    "is_synthetic",
    "missing_fields",
    "next_action",
    "priority",
    "requires_human",
    "root_cause",
    "team_id",
    "user_reply_draft_zh"
  ],
  "additionalProperties": false
}
