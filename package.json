{
  "name": "alphaess-service-desk-demo",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href ./",
    "preview": "node scripts/preview.mjs",
    "test:ci": "ng test --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "python data/scripts/validate_dataset.py",
    "package": "python scripts/package_release.py",
    "release": "npm run test:ci && npm run validate:data && npm run build:pages && npm run package",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "AI 黑客松培训作品：多语言售后工单分诊与人工协同工作台，使用模拟数据与预设建议。"
}
